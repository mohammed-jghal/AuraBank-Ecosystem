# Copy to .env for local runs. No secrets are needed for the PoC:
# the default scorer is deterministic and no LLM API key is used.
PORT=8080
HITL_AMOUNT_THRESHOLD=10000
FRAUD_ESCALATION_THRESHOLD=80
CREDIT_APPROVE_THRESHOLD=650
# LLM_PROVIDER=none  # future: azure_openai (requires a key; not implemented)
